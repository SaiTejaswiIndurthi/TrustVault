# Environment Variables — Copy this file to .env and fill in real secrets

# ─── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development         # development | production
SECRET_KEY=                     # REQUIRED: min 64 chars random secret for JWT signing
CSRF_SECRET=                    # REQUIRED: min 48 chars random secret for CSRF tokens
SESSION_EXPIRE_MINUTES=120

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///trustvault.db   # Dev: SQLite; Prod: postgresql+psycopg2://user:pass@host:5432/trustvault

# ─── CAPTCHA ───────────────────────────────────────────────────────────────────
# Supported providers: dev | turnstile | recaptcha
CAPTCHA_PROVIDER=dev
CAPTCHA_SECRET_KEY=
# In "dev" mode: accepts token "TRUSTVAULT_DEV_CAPTCHA_PASSED" only.
# Shows visible DEV-MODE banner in UI. Never claims real CAPTCHA is active.

# ─── Cloudflare Turnstile (if CAPTCHA_PROVIDER=turnstile) ─────────────────────
# CAPTCHA_SECRET_KEY=<your-turnstile-secret-key>

# ─── Google reCAPTCHA v2/v3 (if CAPTCHA_PROVIDER=recaptcha) ───────────────────
# CAPTCHA_SECRET_KEY=<your-recaptcha-secret-key>

# ─── Document Storage ──────────────────────────────────────────────────────────
# Dev: secure local vault under backend/storage/vault/ (auto-created, outside web root)
# Prod: Configure S3-compatible object store and update local_storage.py
MAX_FILE_SIZE_BYTES=26214400    # 25 MB

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
